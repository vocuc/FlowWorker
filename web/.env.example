# Cấu hình worker FlowKit. Chép thành .env rồi điền (file .env không đưa lên git).
AI90_API_BASE_URL=https://admin.a51.vn/api/v1

# ---- Worker đăng bài: mỗi nền tảng một token ----
# Tạo token trên server: php artisan workers:create {tên}
# rồi admin -> Tài khoản đăng bài: gắn worker với tài khoản A51 + nền tảng tương ứng.
TIKTOK_WORKER_TOKEN=
FACEBOOK_WORKER_TOKEN=
INSTAGRAM_WORKER_TOKEN=

# Profile Chrome riêng của từng worker (đăng nhập sẵn tài khoản nền tảng), mỗi worker một cổng
TIKTOK_CHROME_PROFILE=C:\selenium-tiktok-profile
TIKTOK_CHROME_PORT=9223
FACEBOOK_CHROME_PROFILE=C:\selenium-facebook-profile
FACEBOOK_CHROME_PORT=9224
INSTAGRAM_CHROME_PROFILE=C:\selenium-instagram-profile
INSTAGRAM_CHROME_PORT=9225
# Profile con, mặc định Default
# FACEBOOK_CHROME_PROFILE_DIRECTORY=Default

# 0 = chạy thử: điền xong bài nhưng KHÔNG bấm Đăng / Chia sẻ (job báo lỗi *_AUTO_POST_DISABLED). TikTok luôn chỉ lưu nháp.
FACEBOOK_AUTO_POST=1
INSTAGRAM_AUTO_POST=1

# ---- Logo shop: worker TẠO ẢNH (ImageGenerate.py) chèn vào góc dưới bên phải, % theo cạnh ngắn của ảnh ----
# File logo = ảnh đại diện shop, lấy từ job (người dùng bật "Chèn logo vào ảnh" khi tạo lô). Worker đăng bài không chèn logo.
# LOGO_* dùng chung; IMAGE_LOGO_* riêng worker tạo ảnh.
# LOGO_WIDTH=7
# LOGO_HEIGHT=7
# LOGO_RADIUS=50
# LOGO_X=2
# LOGO_Y=2

# ---- Chế độ --mock (không gọi API) ----
# TIKTOK_MOCK_USERNAME=
# INSTAGRAM_MOCK_USERNAME=
# FACEBOOK_MOCK_TARGET_URL=https://www.facebook.com/groups/...
