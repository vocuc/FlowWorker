# Cấu hình worker đăng bài trên điện thoại Android. Chép thành .env rồi điền (file .env không đưa lên git).
AI90_API_BASE_URL=https://admin.a51.vn/api/v1

# ---- Điện thoại (python worker.py PHONE1) ----
# Mỗi máy 1 bộ tài khoản TikTok / Facebook / Instagram đăng nhập sẵn trong app, nối ADB qua WiFi (chung mạng với PC).
# ADDR: IP:cổng "Gỡ lỗi không dây"; chỉ ghi IP thì worker tự dò cổng (cổng đổi mỗi lần bật lại Gỡ lỗi không dây).
# Ghép đôi 1 lần cho mỗi máy: điện thoại -> Tuỳ chọn nhà phát triển -> Gỡ lỗi không dây -> Ghép nối bằng mã, rồi trên PC:
#   python -c "import adbutils;print(adbutils.adb_path())"     (đường dẫn adb.exe)
#   "<adb.exe>" pair IP:cổng_ghép_nối mã_6_số
# Worker đăng bằng tài khoản đang đăng nhập trong app (không kiểm tra username).
# Token: mỗi tài khoản nền tảng trên máy 1 token worker (php artisan workers:create {tên}),
# admin -> Tài khoản đăng bài: gắn worker với tài khoản A51 + nền tảng tương ứng.
PHONE1_ADDR=
PHONE1_TIKTOK_TOKEN=
PHONE1_INSTAGRAM_TOKEN=
# 0 = chạy thử: điền xong bài nhưng KHÔNG bấm Đăng / Chia sẻ (job báo lỗi *_AUTO_POST_DISABLED)
# PHONE1_TIKTOK_AUTO_POST=0
# PHONE1_INSTAGRAM_AUTO_POST=0

PHONE2_ADDR=
PHONE2_TIKTOK_TOKEN=
PHONE2_INSTAGRAM_TOKEN=

# Logo shop đã được chèn lúc tạo ảnh (worker tạo ảnh), worker đăng bài không chèn logo.
